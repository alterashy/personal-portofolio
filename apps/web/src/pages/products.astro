---
import Layout from '../layouts/Layout.astro';
import { createDbClient, products } from '@portfolio/db';
import { desc } from 'drizzle-orm';

export const prerender = false;

const dbUrl = import.meta.env.DATABASE_URL || process.env.DATABASE_URL || '';
const db = createDbClient(dbUrl);

const allProducts = await db.select().from(products).orderBy(desc(products.createdAt));
---

<Layout title="Products & Store | Personal Portfolio" description="Premium digital products, boilerplate templates, and resources.">
  <div class="py-8">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight mb-2">Products & Store</h1>
      <p class="text-slate-400">Digital goods, boilerplate templates, and resources I've built and actively maintain.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allProducts.length === 0 ? (
        <p class="text-slate-400 col-span-3 py-8 text-center">No products added yet.</p>
      ) : allProducts.map((product) => (
        <div class="glass-card rounded-2xl overflow-hidden flex flex-col group border border-white/5 hover:border-purple-500/30 transition-all">
          {product.coverImage ? (
            <div class="aspect-video w-full overflow-hidden border-b border-white/5">
              <img 
                src={product.coverImage} 
                alt={product.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
          ) : (
            <div class="aspect-video w-full bg-purple-950/20 border-b border-white/5 flex items-center justify-center">
              <span class="text-purple-500/50 font-bold">No Image</span>
            </div>
          )}
          
          <div class="p-6 flex flex-col flex-grow">
            {/* Tags */}
            <div class="flex flex-wrap gap-2 mb-3">
              {(product.tags || []).map((tag) => (
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-950/60 text-purple-300 border border-purple-500/30 uppercase tracking-wider">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between gap-4 mb-1">
              <h2 class="text-2xl font-bold text-white group-hover:text-purple-300 transition-colors">
                {product.title}
              </h2>
              {product.year && (
                <span class="shrink-0 text-xs font-semibold text-slate-400 bg-black/40 px-2 py-1 rounded-lg border border-white/5">
                  {product.year}
                </span>
              )}
            </div>
            {product.visitors > 0 && (
               <p class="text-xs font-semibold text-emerald-400 mb-2">
                 🔥 {product.visitors.toLocaleString()} visitors
               </p>
            )}
            <p class="text-sm text-slate-400 leading-relaxed mb-6 flex-grow">
              {product.description}
            </p>

            <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between">
              {product.demoUrl ? (
                <a
                  href={product.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full text-center py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-sm font-bold shadow-lg shadow-purple-900/20 transition-colors"
                >
                  View Product
                </a>
              ) : (
                <span class="text-sm font-semibold text-slate-500 italic">Coming Soon</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
