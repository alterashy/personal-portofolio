---
import { createDbClient, techStack } from '@portfolio/db';
import { desc } from 'drizzle-orm';
const techIconUrl = (name: string) => `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${name}/${name}-original.svg`;

const dbUrl = import.meta.env.DATABASE_URL || process.env.DATABASE_URL || '';
const db = createDbClient(dbUrl);

const allTech = await db.select().from(techStack).orderBy(desc(techStack.createdAt));

// Group by category
const groupedTech = allTech.reduce((acc, curr) => {
  if (!acc[curr.category]) {
    acc[curr.category] = [];
  }
  acc[curr.category].push(curr);
  return acc;
}, {} as Record<string, typeof allTech>);

const categories = Object.keys(groupedTech);
---

<section class="py-12">
  <div class="mb-8">
    <h2 class="text-3xl font-bold tracking-tight">Core Tech Stack</h2>
    <p class="text-slate-400 text-sm mt-1">Tools and frameworks I leverage to build production applications.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {categories.length === 0 ? (
      <p class="text-slate-400 col-span-3 text-center py-8">No tech stack items added yet. Add some in the CMS!</p>
    ) : categories.map((cat) => (
      <div class="glass-panel rounded-2xl p-6 border border-white/10">
        <h3 class="text-lg font-bold text-purple-300 mb-4 border-b border-white/10 pb-2">
          {cat}
        </h3>
        <div class="flex flex-col gap-3">
          {groupedTech[cat].map((item) => (
            <div class="flex items-center gap-3 p-2.5 rounded-xl bg-white/5 border border-white/5 hover:border-purple-500/30 transition-colors">
              {item.icon && (
                <img
                  src={item.icon.includes('/') || item.icon.startsWith('http') ? item.icon : techIconUrl(item.icon)}
                  alt={item.name}
                  class="w-6 h-6 object-contain rounded bg-white/10 p-0.5"
                />
              )}
              <span class="text-sm font-semibold text-slate-200">{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
