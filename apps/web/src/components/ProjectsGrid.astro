---
import { createDbClient, projects } from '@portfolio/db';
import { desc, eq } from 'drizzle-orm';

interface Props {
  featuredOnly?: boolean;
}

const { featuredOnly = false } = Astro.props;

const dbUrl = import.meta.env.DATABASE_URL || process.env.DATABASE_URL || '';
const db = createDbClient(dbUrl);

let query = db.select().from(projects).orderBy(desc(projects.createdAt));

if (featuredOnly) {
  query = db.select().from(projects).where(eq(projects.featured, true)).orderBy(desc(projects.createdAt));
}

const allProjects = await query;
---

<section class="py-12">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-3xl font-bold tracking-tight">Featured Projects</h2>
      <p class="text-slate-400 text-sm mt-1">A selection of recent applications and open source work.</p>
    </div>
    <a href="/projects" class="text-sm font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1">
      View All &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {allProjects.length === 0 ? (
      <p class="text-slate-400 col-span-3 text-center py-8">No projects added yet.</p>
    ) : allProjects.map((project) => (
      <div class="glass-card rounded-2xl p-6 flex flex-col justify-between group">
        <div>
          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.map((tag) => (
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-purple-950/50 text-purple-300 border border-purple-500/20">
                {tag}
              </span>
            ))}
          </div>

          <!-- Title & Year -->
          <div class="flex items-center justify-between mb-2 gap-4">
            <h3 class="text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
              {project.title}
            </h3>
            {project.year && (
              <span class="shrink-0 text-xs font-semibold text-slate-400 bg-black/40 px-2 py-1 rounded-lg border border-white/5">
                {project.year}
              </span>
            )}
          </div>

          <!-- Description -->
          <p class="text-sm text-slate-400 leading-relaxed mb-6">
            {project.description}
          </p>
        </div>

        <!-- Links -->
        <div class="flex items-center justify-between pt-4 border-t border-white/10 mt-auto">
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-slate-200 hover:text-purple-300 flex items-center gap-1.5"
          >
            Live Demo
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-slate-400 hover:text-slate-200 flex items-center gap-1"
          >
            GitHub
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
